# Copy to .env and fill in.   cp .env.example .env

# --- Delta Exchange API key (Delta app/website -> Account -> API Keys) ---
# Give the key "Trading" permission. Whitelist your server's IP. Never enable withdrawals.
DELTA_API_KEY=
DELTA_API_SECRET=
DELTA_REGION=india          # india (api.india.delta.exchange) or global (api.delta.exchange)
DELTA_TESTNET=false         # true = Delta demo/testnet account (needs testnet API keys)

# --- Mode ---
BOT_MODE=paper              # paper = simulated money on real prices; live = real orders
LIVE_TRADING_CONFIRMED=no   # must be "yes" for live mode to start

SETTLE_ASSET=USD            # wallet asset used to measure equity

# --- Market selection ---
MIN_TURNOVER_USD=2000000    # ignore markets with less 24h volume than this
UNIVERSE_SIZE=25            # analyse the N most liquid perpetuals
CRYPTO_ONLY=true            # skip gold/silver/stock tokens (Delta "tradfi" products)
BLACKLIST=                  # e.g. ARIAUSD,ALTUSD

# --- Risk (the most important settings) ---
RISK_PER_TRADE=0.01         # lose at most ~1% of equity if a stop-loss hits
MAX_POSITIONS=3
LEVERAGE=5                  # per-product leverage set on the exchange
MAX_TOTAL_NOTIONAL_X=3      # total open position value <= 3x equity
DAILY_LOSS_LIMIT=0.04       # stop opening trades after -4% in a day
MAX_DRAWDOWN=0.20           # close everything and halt after -20% from peak

PAPER_START_EQUITY=1000

# --- What to trade ---
# Comma list in order of preference. For each trending market the bot uses the first that works:
#   options   -> BUY a call (uptrend) or put (downtrend) on BTC / ETH / XAUT. Max loss = premium.
#   futures   -> dated futures on the same coin (used only if Delta lists any)
#   perpetual -> perpetual futures (all 200+ coins)
# Examples:  perpetual            (default)
#            options,perpetual    (options on BTC/ETH/XAUT, perps for everything else)
#            options              (options only)
INSTRUMENTS=perpetual

# --- Options settings (only used when INSTRUMENTS includes options) ---
OPT_TARGET_DTE=14           # preferred days to expiry
OPT_MIN_DTE=4
OPT_MAX_DTE=35
OPT_TARGET_DELTA=0.45       # 0.5 = at-the-money, lower = cheaper / further out-of-the-money
OPT_MAX_SPREAD=0.12         # skip contracts whose bid/ask spread is wider than 12%
OPT_STOP_LOSS=0.5           # sell if the option loses 50% of its price
OPT_TAKE_PROFIT=1.5         # sell if the option gains 150%
OPT_MAX_PREMIUM_PCT=0.03    # never spend more than 3% of equity on one option trade

# --- Optional Telegram alerts (create a bot with @BotFather) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Claude AI bot (arena) ---
# Anthropic API key from console.anthropic.com. Used only to call Claude from this computer.
ANTHROPIC_API_KEY=            # optional: only needed if the Claude Code CLI is not installed

# --- ChatGPT trader (AI duel) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
